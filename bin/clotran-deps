#!/bin/sh
# clotran-deps [-A:alias[:alias...]] [dir]
#
# Prints the CLOTRAN_PATH for the project in dir (default: here), from its
# deps.edn, fetching what it names first; exits 1 with the reason on
# stderr when it cannot. The `clotran` command resolves a project's
# deps.edn itself, through the same code (clotran.deps/cached-path); by hand:
#
#   CLOTRAN_PATH=$(clotran-deps) clotran app.cljf
#
# The answer is cached in dir/.clotran-cache with the deps.edn files it was
# read from, and reused while none of them has changed. Everything is
# clotran.deps/-main; this only finds a clotran to run it on: CLOTRAN (a
# checkout or an installed home), else a checkout beside this one, else the
# clotran on PATH. (On Windows, bin\clotran-deps.cmd in a release.)
here=$(cd "$(dirname "$0")/.." && pwd)
if [ -n "$CLOTRAN" ]; then clotran_cmd="$CLOTRAN/clotran"
elif [ -x "$here/../clotran/clotran" ]; then clotran_cmd="$here/../clotran/clotran"
else clotran_cmd=$(command -v clotran) || { echo "clotran-deps: no clotran found (set CLOTRAN, or put clotran on PATH)" >&2; exit 1; }
fi
CLOTRAN_PATH="$here/src" exec "$clotran_cmd" -m clotran.deps "$@" </dev/null
