(ns clotran.deps
  "clotran's package manager: reads a project's deps.edn -- the same file
  and keys a Clojure project has -- fetches what it names, and answers
  the source path clotran searches (CLOTRAN_PATH), as tools.deps answers
  clj's classpath. See clotran's PACKAGES.md for the design.

  Coordinates:
    {:local/root \"dir\"}                  a directory with its own deps.edn
    {:git/url \"...\" :git/sha \"<full>\"}   fetched once, by sha, into the cache
                                         (clotran.cache: ~/.clotran/cache/tree,
                                         or $CLOTRAN_CACHE); a :git/tag beside
                                         it is a label, checked to name that
                                         sha when it is fetched
    {:mvn/version \"...\"}                 org.clojure/clojure and the spec
                                         libraries are PROVIDED (clotran is
                                         the Clojure); any other jar is refused
  A library named at two different coordinates is an error naming both,
  unless the project's own :deps names it: the project always wins."
  (:require [clojure.edn :as edn]
            [clojure.string :as str]
            [clotran.cache :as cache]))

(def provided
  "Libraries clotran itself is: named in a deps.edn for clj's sake,
  nothing to fetch here."
  #{'org.clojure/clojure 'org.clojure/spec.alpha 'org.clojure/core.specs.alpha})

(defn- fail [msg data] (throw (ex-info (str "clotran-deps: " msg) data)))

(defn- normalize
  "A path with its . and dir/.. segments taken out, so an error names
  the place, not the route to it."
  [p]
  (let [abs (str/starts-with? p "/")
        parts (reduce (fn [acc seg]
                        (cond (or (= seg "") (= seg ".")) acc
                              (and (= seg "..") (seq acc) (not= (peek acc) "..")) (pop acc)
                              :else (conj acc seg)))
                      [] (str/split p #"/"))]
    (str (when abs "/") (str/join "/" parts))))

(def ^:private windows? (= ";" (clotran.host.system/getProperty "path.separator")))

(defn- join
  "p from dir. On Windows a \\ separates too, as clj's host reads a path
  there (C:\\lib, ..\\lib); elsewhere it is part of a name."
  [dir p]
  (let [p (if windows? (str/replace p "\\" "/") p)]
    (normalize (cond (re-find #"^([A-Za-z]:)?/" p) p   ; absolute, C:/ on Windows
                     (or (= dir ".") (= dir "")) p
                     :else (str dir "/" p)))))

(defn- check-deps
  "The shape tools.deps accepts, or an error naming the file: a map, its
  :deps a map of coordinate maps, its :paths a vector of strings. clj
  refuses all of these (`clj -Spath`, \"Error reading deps\"); taking them
  answered a path built from nothing (scripts/fuzz-deps, malformed)."
  [f m]
  (let [bad (fn [what] (fail (str f ": " what) {:file f}))]
    ;; nil is no deps, as an empty file is
    (when-not (or (nil? m) (map? m)) (bad "deps.edn must be a map"))
    (when (contains? m :deps)
      (when-not (map? (:deps m)) (bad ":deps must be a map of libraries to coordinates"))
      (doseq [[lib coord] (:deps m)]
        (when-not (symbol? lib) (bad (str "a library is a symbol, not " (pr-str lib))))
        (when-not (map? coord) (bad (str lib " has no coordinate clotran-deps knows")))
        (when (and (contains? coord :local/root) (not (string? (:local/root coord))))
          (bad (str lib "'s :local/root must be a string")))))
    (when (contains? m :paths)
      (when-not (and (vector? (:paths m)) (every? string? (:paths m)))
        (bad ":paths must be a vector of strings")))
    (or m {})))

(defn read-deps
  "The deps.edn in dir, or {} when there is none or it is empty, as for
  clj; a file that is not EDN, or not the shape of one, is an error
  naming it."
  [dir]
  (let [f (join dir "deps.edn")]
    (if (clotran-file-exists? f)
      (let [text (slurp f)]
        (if (str/blank? text)
          {}
          ;; every form in it, so text after the first is not ignored:
          ;; tools.deps wants exactly one
          (let [forms (try (edn/read-string (str "[" text "\n]"))
                           (catch clotran.host.exception e
                             (fail (str f ": " (ex-message e)) {:file f})))]
            (when (> (count forms) 1)
              (fail (str f ": more than one form; a deps.edn is one map") {:file f}))
            (check-deps f (first forms)))))
      {})))

(defn- with-aliases
  "deps with the :extra-paths and :extra-deps of the named aliases added."
  [deps aliases]
  (reduce (fn [d a]
            (let [al (get-in deps [:aliases a])]
              (when-not al (fail (str "no alias " a) {:alias a}))
              (-> d
                  ;; onto the default ["src"] when the file names no :paths
                  (update :paths #(into (or % ["src"]) (:extra-paths al)))
                  (update :deps merge (:extra-deps al)))))
          deps aliases))

(def ^:dynamic *fetch*
  "Whether a library not in the cache yet is fetched, or refused: only
  `clotran deps` (and the clotran-deps script) fetch; running a program,
  a REPL or the tests never downloads anything."
  false)

(defn- run-git! [argv what]
  ;; no shell between: the program and its arguments, as they are
  (when-not (zero? (clotran-run argv nil nil nil true)) (fail (str what " failed") {:command argv})))

(defn- tag-sha
  "The commit tag names at url, or nil: from GitHub's API when the
  repository is on GitHub (no git needed), else git ls-remote, its
  peeled line (^{}) for an annotated tag."
  [dir repo url tag]
  (let [out (str dir ".tag")
        read! (fn [] (let [t (when (clotran-file-exists? out) (clotran-slurp out))]
                       (when (clotran-file-exists? out) (clotran-delete out))
                       t))
        gh (when (and repo (zero? (clotran-run ["curl" "-fsSL" "-H" "Accept: application/vnd.github.sha" "-o" out
                                                (str "https://api.github.com/repos/" repo "/commits/refs/tags/" tag)] nil nil nil true)))
             (str/trim (or (read!) "")))]
    (or (not-empty gh)
        (do (clotran-run ["git" "ls-remote" url (str "refs/tags/" tag) (str "refs/tags/" tag "^{}")] nil out nil true)
            (let [lines (str/split-lines (or (read!) ""))
                  line (or (first (filter #(str/ends-with? % "^{}") lines)) (first lines))]
              (when line (first (str/split line #"\s+"))))))))

(defn git-dir
  "The tree of url at sha, fetched the first time it is asked for into
  the cache's tree directory (clotran.cache), and never changed after: a
  sha names one tree. Only that tree comes, never the repository's
  history: from GitHub its archive of the sha (curl and tar, which every
  system has, Windows 10 on; no git needed), elsewhere -- or when the
  archive cannot be had, a private repository -- git fetching that one
  commit at depth 1. A marker written last says the tree is whole, so a
  fetch cut short is fetched again. clotran's launcher calls it for a
  tool tools.edn pins, with no tag."
  ([lib url sha] (binding [*fetch* true] (git-dir lib url sha nil)))
  ([lib url sha tag]
   (when-not (and (string? sha) (re-matches #"[0-9a-f]{40}" sha))
     (fail (str lib " needs a full 40-character :git/sha") {:lib lib :sha sha}))
   (let [dir (cache/src-dir lib sha)
         done (str dir "/.clotran-fetched")
         what (str "fetching " lib)]
     (when-not (clotran-file-exists? done)
       (when-not *fetch*
         (fail (str lib " is not fetched yet: `clotran deps` fetches what deps.edn names") {:lib lib :sha sha}))
       (clotran-mkdirs dir)
       (let [[_ repo] (re-matches #"(?:https://|git@)github\.com[/:]([^/]+/[^/]+?)(?:\.git)?/?" url)
             tgz (str dir ".tar.gz")]
         ;; the sha is what is fetched; a tag is only checked to agree
         (when tag
           (let [t (tag-sha dir repo url tag)]
             (when-not (= t sha)
               (fail (str lib "'s :git/tag " tag " names " (or t "no commit") ", not its :git/sha " sha)
                     {:lib lib :tag tag :sha sha :tag-sha t}))))
         (if (and repo (zero? (clotran-run ["curl" "-fsSL" "-o" tgz (str "https://codeload.github.com/" repo "/tar.gz/" sha)] nil nil nil true)))
           (do (run-git! ["tar" "-xzf" tgz "--strip-components" "1" "-C" dir] (str "unpacking " lib))
               (clotran-delete tgz))
           (do (run-git! ["git" "-C" dir "init" "--quiet"] what)
               (run-git! ["git" "-C" dir "fetch" "--quiet" "--depth" "1" url sha] what)
               (run-git! ["git" "-C" dir "-c" "advice.detachedHead=false" "checkout" "--quiet" "FETCH_HEAD"] what))))
       (clotran-spit done sha))
     dir)))

(defn- dep-dir
  "Where a coordinate's source is, relative to from (the directory whose
  deps.edn named it); nil for a provided library."
  [lib coord from]
  (cond (provided lib) nil
        (:local/root coord) (let [d (join from (:local/root coord))]
                              (when-not (clotran-file-exists? d)
                                (fail (str "local lib " lib " not found: " d) {:lib lib :dir d}))
                              d)
        (:git/url coord) (git-dir lib (:git/url coord) (:git/sha coord) (:git/tag coord))
        (:mvn/version coord) (fail (str lib " is a Maven jar, compiled for another host; give it a :git/url or :local/root")
                                   {:lib lib :coord coord})
        :else (fail (str lib " has no coordinate clotran-deps knows") {:lib lib :coord coord})))

(defn resolve-deps
  "Every library the project in dir needs, breadth first: lib -> {:dir
  :coord :from}. The project's own :deps are fixed first and win."
  ([dir] (resolve-deps dir []))
  ([dir aliases]
   (let [top (with-aliases (read-deps dir) aliases)
         pinned (set (keys (:deps top)))]
     (loop [queue (vec (for [[lib coord] (:deps top)] [lib coord dir]))
            found {}]
       (if (empty? queue)
         found
         (let [[[lib coord from] & more] queue
               d (dep-dir lib coord from)]
           (cond
             (nil? d) (recur (vec more) found)
             (contains? found lib)
             ;; the project's own choice was queued first, so it is the
             ;; one found; anyone else disagreeing is only an error when
             ;; the project has not chosen
             (let [had (get found lib)]
               (when (and (not (pinned lib)) (not= (:dir had) d))
                 (fail (str lib " is wanted at two places: " (:dir had) " (by " (:from had) ") and " d " (by " from ")")
                       {:lib lib}))
               (recur (vec more) found))
             :else
             (let [theirs (read-deps d)]
               (recur (into (vec more) (for [[l c] (:deps theirs)] [l c d]))
                      (assoc found lib {:dir d :coord coord :from from :paths (or (:paths theirs) ["src"])}))))))))))

(defn source-path
  "The project's own :paths, then each library's, as CLOTRAN_PATH entries."
  ([dir] (source-path dir []))
  ([dir aliases]
   (let [top (with-aliases (read-deps dir) aliases)
         libs (resolve-deps dir aliases)]
     (vec (concat (map #(join dir %) (or (:paths top) ["src"]))
                  (for [[_ {d :dir ps :paths}] (sort-by key libs), p ps] (join d p)))))))

(defn path-string
  "source-path joined as CLOTRAN_PATH wants it: by the host's path.separator,
  ; on Windows, where : is part of a drive."
  [dir aliases]
  (str/join (or (clotran.host.system/getProperty "path.separator") ":") (source-path dir aliases)))

(defn resolution
  "The path; every deps.edn that went into it, since a cached path is good
  for as long as those files are unchanged; and each library's directory,
  coordinate and paths (:libs), for a tool that wants to know where a
  dependency's sources are without resolving again -- an editor's index
  (clotran's PLAN step 36)."
  [dir aliases]
  (let [libs (resolve-deps dir aliases)
        files (->> (cons dir (map :dir (vals libs)))
                   (map #(join % "deps.edn"))
                   (filter clotran-file-exists?)
                   distinct)]
    {:path (path-string dir aliases) :files (vec files)
     :libs (into {} (for [[lib {:keys [dir coord paths]}] libs] [lib {:dir dir :coord coord :paths paths}]))}))

(defn- sums [files] (mapv #(hash (clotran-slurp %)) files))

(defn cached-path
  "path-string for the project in dir, through dir/.clotran-cache/deps.edn:
  the answer is kept with the deps.edn files it was read from, their sums
  and each library's directory (:libs, resolution), and reused while none
  of the files has changed and the aliases are the same -- so an unchanged
  project resolves nothing. clotran's launcher calls this in a project
  directory."
  [dir aliases]
  (let [cache (join dir ".clotran-cache/deps.edn")
        old (when (clotran-file-exists? cache)
              (try (read-string (clotran-slurp cache)) (catch clotran.host.exception _ nil)))]
    (if (and (map? old) (= (:aliases old) (vec aliases))
             (every? clotran-file-exists? (:files old))
             (= (:sums old) (sums (:files old))))
      (:path old)
      (let [{:keys [path files libs]} (resolution dir aliases)]
        (clotran-mkdirs (join dir ".clotran-cache"))
        (clotran-spit cache (pr-str {:aliases (vec aliases) :files files :sums (sums files) :path path :libs libs}))
        path))))

(defn- args->aliases+dir [args]
  [(vec (for [a args :when (str/starts-with? a "-A")
              al (str/split (subs a 2) #":") :when (seq al)]
          (keyword al)))
   (or (last (remove #(str/starts-with? % "-A") args)) ".")])

(defn fetch-main
  "`clotran deps [-A:alias...] [dir]`: fetches every library the project
  in dir names, and says which are ready; the reason on stderr and status
  1 when one cannot be had."
  [& args]
  (let [[aliases dir] (args->aliases+dir args)]
    (try (binding [*fetch* true]
           (cached-path dir aliases)
           (let [libs (sort (map str (keys (resolve-deps dir aliases))))]
             (println (if (seq libs) (str "ready: " (str/join " " libs)) "deps.edn names no libraries"))))
         (catch clotran.host.exception e
           (binding [*out* *err*] (println (ex-message e)))
           (clotran.host.system/exit 1)))))

(defn -main
  "`clotran-deps [-A:alias[:alias...]] [dir]`: the CLOTRAN_PATH of the
  project in dir (default: here), fetching what its deps.edn names first;
  the reason on stderr and status 1 when it cannot be resolved."
  [& args]
  (let [[aliases dir] (args->aliases+dir args)]
    (try (println (binding [*fetch* true] (cached-path dir aliases)))
         (catch clotran.host.exception e
           (binding [*out* *err*] (println (ex-message e)))
           (clotran.host.system/exit 1)))))
